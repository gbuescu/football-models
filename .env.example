# Copy this file to .env and fill in your own values.
# .env is gitignored. Never put a real key in this file.

# Required by all four scripts.
# Free key: https://www.football-data.org/client/register
# The free tier gives scores and half-time scores only, at 10 requests a minute.
FOOTBALL_DATA_KEY=your_football_data_org_key_here

# Optional, and only read by regular_prediction_model.py.
# An API-Football (api-sports.io) key, used to pull real corner counts.
# Leave it blank and the corner model falls back to the goal-rating proxy.
APISPORTS_KEY=
